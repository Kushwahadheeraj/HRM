{
  "name": "traxale-hrm-server",
  "version": "1.0.0",
  "description": "Professional Backend for Traxale HRM Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');const s=path.join(__dirname,'src','assets'),d=path.join(__dirname,'dist','assets');if(fs.existsSync(s)){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s))fs.copyFileSync(path.join(s,f),path.join(d,f));console.log('✅ Copied src/assets → dist/assets');}\"",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed": "ts-node-dev src/utils/seedData.ts"
  },
  "keywords": [ 
    "hrm",
    "backend",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Traxale Team",
  "license": "MIT",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@slack/events-api": "^3.0.1",
    "@slack/web-api": "^7.18.0",
    "@types/express-fileupload": "^1.5.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.0",
    "node": "^26.5.0",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
